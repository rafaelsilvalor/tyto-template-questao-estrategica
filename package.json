{
  "name": "tyto-template-questao-estrategica",
  "version": "0.3.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The question carousel (cover, statement, answer, sign-off), a Tyto code template in its own repository.",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": "^22.22.2 || ^24.15 || >=26"
  },
  "files": [
    "tyto-plugin.json",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@tyto/core": "npm:@rafaelsilvalor/tyto-core@^0.34.0",
    "@tyto/house-style": "npm:@rafaelsilvalor/tyto-house-style@^0.4.0",
    "@tyto/plugin-api": "npm:@rafaelsilvalor/tyto-plugin-api@^0.11.0",
    "@tyto/template-kit": "npm:@rafaelsilvalor/tyto-template-kit@^0.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
